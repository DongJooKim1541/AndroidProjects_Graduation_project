<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 잠금화면은 화면이 꺼질 때 백그라운드에서 액티비티를 띄운다.
         API 29 부터 백그라운드 액티비티 시작은 이 권한을 가진 앱만 허용된다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 재부팅 시 lockState 를 미사용으로 되돌리기 위해 부팅 완료를 받는다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_main"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_main_round"

        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".ui.activity.MainActivity">
        </activity>
        <receiver android:name=".lock_screen.ScreenReceiver"></receiver>
        <!-- ScreenReceiver 와 달리 부팅 완료는 매니페스트 선언으로만 받을 수 있다.
             (ACTION_SCREEN_OFF 는 반대로 런타임 등록만 가능하다.) -->
        <receiver
            android:name=".lock_screen.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".lock_screen.ScreenService"
            android:enabled="true"
            android:exported="true"></service>
        <activity android:name=".ui.activity.LockScreenActivity"></activity>
        <activity android:name=".ui.activity.LoginActivity"></activity>
        <activity android:name=".ui.activity.SignUpActivity"></activity>
        <service android:name=".lock_screen.ShowForegroundService"/>

        <activity
            android:name=".ui.activity.SplashActivity"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>
    </application>

    <uses-permission android:name="android.permission.INTERNET" ></uses-permission>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
</manifest>